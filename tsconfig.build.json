{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "declaration": true,
        "declarationDir": "./dist",
        "rootDir": "./src",
        "emitDeclarationOnly": true,
        "outDir": "./dist"
    },
    "include": ["src"],
    "exclude": [
        "src/**/*.test.tsx",
        "src/**/*.test.ts",
        "src/**/*.stories.tsx",
        "src/test-utils",
        "src/stories"
    ]
}
