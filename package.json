{
  "name": "monitor-ui",
  "version": "0.1.0",
  "description": "3-level React monitoring UI: MiniWidget → Drawer → Dashboard",
  "license": "MIT",
  "author": "pilmee <pilmee@gmail.com>",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "react",
    "monitor",
    "performance",
    "dashboard",
    "widget",
    "devtools"
  ],
  "homepage": "https://github.com/ElJijuna/monitor-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ElJijuna/monitor-ui.git"
  },
  "bugs": {
    "url": "https://github.com/ElJijuna/monitor-ui/issues"
  },
  "scripts": {
    "build": "vite build",
    "build:check": "tsc -p tsconfig.build.json --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@gnome-ui/charts": "^1.30.0",
    "@gnome-ui/core": "^1.42.3",
    "@gnome-ui/hooks": "^1.28.0",
    "@gnome-ui/layout": "^1.28.1",
    "@gnome-ui/react": "^1.45.0",
    "monitor-api": "^1.1.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@gnome-ui/charts": "^1.30.0",
    "@gnome-ui/core": "^1.42.3",
    "@gnome-ui/hooks": "^1.28.0",
    "@gnome-ui/layout": "^1.28.1",
    "@gnome-ui/react": "^1.45.0",
    "@storybook/react-vite": "^10.4.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "monitor-api": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.4.1",
    "ts-jest": "^29.4.3",
    "typescript": "^5.9.3",
    "vite": "8.0.7",
    "vite-plugin-dts": "^5.0.1"
  },
  "overrides": {
    "vite": "8.0.7"
  }
}
